
{
  "id": "dev.akira.bitchord-hires",
  "name": "juanjob hi res",
  "version": "1.0.0",
  "resources": [
    "search",
    "stream"
  ],
  "checkValidLossless": 1,
  "allowDownloads": 1,
  "settings": [
    {
      "key": "quality",
      "type": "select",
      "default": "lossless",
      "options": [
        {
          "label": "Lossless (FLAC, hasta 24/192)",
          "value": "lossless"
        },
        {
          "label": "High (FLAC, hasta 24/96)",
          "value": "high"
        },
        {
          "label": "Low (ahorro de datos)",
          "value": "low"
        }
      ]
    },
    {
      "key": "atmos",
      "type": "select",
      "default": "stereo",
      "options": [
        {
          "label": "Stereo only",
          "value": "stereo"
        },
        {
          "label": "Dolby Atmos when available",
          "value": "auto"
        }
      ]
    }
  ]
}
